
VITE_API_BASE_URL=https://mediscan.fastapicloud.dev

# --- Feature flags (read when the dev server starts or the app is built) ---
# Scan workflow and reports are ON by default: the deployed backend implements
# both. Set to 0 only to point the app at an older backend that lacks them.
# VITE_SCAN_WORKFLOW=0
# VITE_REPORTS=0
# Original demo signup flow (fake email verification -> onboarding). Demos only,
# never for real users. Off unless set to 1.
# VITE_DEMO_SIGNUP_FLOW=1
