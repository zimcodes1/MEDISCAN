+++ b/src/lib/dashboard.ts
@@ -0,0 +1,30 @@
+import { api } from "./api";
+
+export interface DashboardStats {
+  total_scans: number;
+  pending_review: number;
+  urgent: number;
+  flagged: number;
+  reviewed_today: number;
+}
+
+export interface ActivityItem {
+  id: string;
+  type: string;
+  message: string;
+  actor: { id: string; full_name: string } | null;
+  scan_id: string | null;
+  created_at: string;
+}
+
+export async function getDashboardStats(): Promise<DashboardStats> {
+  const { data } = await api.get<DashboardStats>("/dashboard/stats");
+  return data;
+}
+
+export async function listActivity(limit = 10): Promise<ActivityItem[]> {
+  const { data } = await api.get<ActivityItem[]>("/activity", {
+    params: { limit },
+  });
+  return data;
+}
diff --git a/src/lib/features.ts b/src/lib/features.ts
new file mode 100644
index 0000000..c3b775c
--- /dev/null
+++ b/src/lib/features.ts
@@ -0,0 +1,11 @@
+/** Dev-only API stand-in (see src/dev/shim.ts). Never active in a production build. */
+export const API_SHIM =
+  import.meta.env.DEV && import.meta.env.VITE_API_SHIM === "1";
+
+/**
+ * True when the backend implements the scan-workflow part of api-contract.md
+ * (scan priority / assignment / review fields, /staff, /dashboard/stats,
+ * /activity). Set VITE_SCAN_WORKFLOW=1 in .env.local once it does.
+ */
