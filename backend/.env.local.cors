# Backend env block for local frontend + deployed backend
ENVIRONMENT=production
DEBUG=false

DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

INFERENCE_BACKEND=mock
MAX_UPLOAD_MB=10

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://mediscan-ng.vercel.app"]

RATE_LIMIT_ENABLED=true
TRUSTED_PROXY_HOPS=0
MAX_INFLIGHT_PREDICTIONS=4
