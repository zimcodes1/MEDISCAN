ENVIRONMENT=development
DEBUG=false

# Paste Neon connection string as-is (pooled or direct).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

INFERENCE_BACKEND=mock
MAX_UPLOAD_MB=10

# JSON list
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Abuse protection
RATE_LIMIT_ENABLED=true
# Reverse proxies in front of the app (0 = ignore X-Forwarded-For; see backend/core/net.py)
TRUSTED_PROXY_HOPS=0
MAX_INFLIGHT_PREDICTIONS=4
